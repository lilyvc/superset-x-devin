# --- required for real operation -------------------------------------------
# Repository the automation watches, in owner/name form.
TARGET_REPO=your-github-user/superset

# Devin API credential. For a running service use a service-user API key
# (Settings -> Devin API -> Service users). A PAT also works on v3 but the
# sessions then run as that human user — PATs are for scripts, not services.
# Either way, set DEVIN_ORG_ID below so requests use the org-scoped v3 API.
DEVIN_API_KEY=

# Required org id (org-...) for the production v3 API. Find it in the Devin
# webapp URL or org settings.
DEVIN_ORG_ID=

# GitHub token with Issues read/write, Pull requests read/write, Checks read,
# and Commit statuses read on the target repo.
GITHUB_TOKEN=

# Only needed if you use GitHub webhooks.
GITHUB_WEBHOOK_SECRET=

# Only needed for POST /admin/poll-now.
ADMIN_TOKEN=

# --- optional ----------------------------------------------------------------
# DEVIN_API_BASE_URL=https://api.devin.ai
# GITHUB_API_URL=https://api.github.com        # set for GHES
# MAX_ACU_LIMIT=                               # cap ACUs per Devin session
# MAX_TOTAL_ACUS=                              # org-level ACU budget ceiling across all sessions

# --- autonomous intake -------------------------------------------------------
# Intake is autonomous: every open issue is discovered and triaged. Set a label
# to restrict intake to issues carrying it (opt-in gating, off by default).
# ELIGIBILITY_LABEL=
# TRIAGE_ENABLED=true                          # false = queue straight to Investigator
# TRIAGE_ACU_LIMIT=2                           # cheap intake verdict
# MAX_NEW_ISSUES_PER_POLL=5
# ISSUE_LOOKBACK_DAYS=                         # empty = no age limit
# IGNORE_LABELS=question,duplicate,invalid,wontfix,discussion,rfc,sip,devin-analysis
# IGNORE_ISSUE_TYPES=feature,task,epic
# MAX_CONCURRENT_DEVINS=3
# MAX_REMEDIATION_ATTEMPTS=2
# ANALYSIS_ENABLED=true
# INVESTIGATOR_ACU_LIMIT=10
# REMEDIATOR_ACU_LIMIT=25
# ANALYST_ACU_LIMIT=8
# DEDUP_ENABLED=true                           # scan open PRs for duplicates before remediating
# DEDUP_ACU_LIMIT=3                            # ACU cap for the Dedup adjudication session
# CI_REQUIRED=true                             # require the fix PR's GitHub checks green for READY_FOR_REVIEW
# CI_TIMEOUT_SECONDS=14400                     # bound on the CI wait before a ci_timeout event
# SESSION_STALL_SECONDS=5400                   # nudge a never-settling session, escalate at 2x
# DB_PATH=orchestrator.db

# --- polling mode (alternative to webhooks) ------------------------------------
# ENABLE_POLLING=false           # on by default; set false to run webhook-only
# GITHUB_POLL_INTERVAL_SECONDS=5
# POLL_BACKLOG=true              # also dispatch issues that already existed at startup
